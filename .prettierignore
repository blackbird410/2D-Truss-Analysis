# ==============================================================================
# Prettier Ignore File - 2D Truss Analysis Project
# ==============================================================================
#
# Purpose:
#   Exclude files and directories from Prettier formatting to prevent conflicts
#   with other formatters, preserve generated code, and protect binary files.
#
# Alignment with .gitignore:
#   This file mirrors relevant patterns from .gitignore for consistency.
#
# References:
#   - Prettier Ignore Documentation: https://prettier.io/docs/en/ignore.html
#   - Project .gitignore: /.gitignore
#
# ==============================================================================

# Build Artifacts and Generated Files
# ------------------------------------------------------------------------------
# CMake build outputs (all configurations)
build/
build_*/
build_debug/
build_coverage/
build_linux/

# CMake-generated files
**/CMakeFiles/
**/*.cmake
!cmake/*.cmake
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
DartConfiguration.tcl
_deps/

# Qt MOC/UIC/RCC generated files
*_autogen/
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm

# Testing outputs
Testing/
test_input/
test_output/
cppcheck-report.txt
coverage.info
coverage_filtered.info
build_coverage/coverage_html/

# Source Code (Not Handled by Prettier)
# ------------------------------------------------------------------------------
# C/C++ files are formatted by clang-format, not Prettier
**/*.cpp
**/*.hpp
**/*.h
**/*.c
**/*.cc
**/*.cxx

# Makefiles use tabs (handled by EditorConfig)
Makefile
Makefile-template
*.mk

# Binary and Media Files
# ------------------------------------------------------------------------------
*.o
*.obj
*.so
*.a
*.dylib
*.dll
*.exe
*.app

# Media files
*.mp4
*.h264
*.jpg
*.jpeg
*.png
*.gif
*.svg
*.webp

# Third-Party and Vendor Code
# ------------------------------------------------------------------------------
node_modules/
vendor/
vcpkg_installed/
.flatpak-builder/

# IDE and Editor Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace
.DS_Store

# Archived Documentation (Preserve As-Is)
# ------------------------------------------------------------------------------
# Historical documentation should not be reformatted
docs/archive/

# Configuration Files Requiring Exact Formatting
# ------------------------------------------------------------------------------
# Flatpak manifests (YAML but with strict formatting requirements)
flatpak/*.yml

# Docker Compose (if strict ordering is needed)
# docker-compose*.yml

# Package Management
# ------------------------------------------------------------------------------
package-lock.json
yarn.lock
pnpm-lock.yaml

# Version Control and CI
# ------------------------------------------------------------------------------
.git/
.github/

# Backup and Temporary Files
# ------------------------------------------------------------------------------
*.bak
*.backup
*.tmp
*.log
*.cache
