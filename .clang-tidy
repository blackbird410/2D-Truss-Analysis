# ==============================================================================
# clang-tidy Configuration - 2D Truss Analysis Project
# ==============================================================================
#
# Purpose:
#   Static analysis configuration for modern C++20 code quality enforcement.
#   Detects bugs, performance issues, style violations, and modernization opportunities.
#
# Scope:
#   - Bug detection (potential crashes, logic errors, undefined behavior)
#   - Performance optimization (unnecessary copies, inefficient algorithms)
#   - Code modernization (C++20 best practices, deprecated features)
#   - Readability and maintainability (naming conventions, complexity metrics)
#
# Usage:
#   make lint                # Run clang-tidy on all source files
#   clang-tidy file.cpp      # Analyze single file
#   clang-tidy -p build/     # Use compile_commands.json from build/
#
# Integration:
#   - Requires compile_commands.json (generated by CMake)
#   - Works alongside clang-format (formatting) and cppcheck (additional static analysis)
#   - Applied only to project source code (src/, tests/)
#
# Requirements:
#   - clang-tidy 14+ (for full C++20 support)
#   - CMake-generated compile_commands.json
#
# References:
#   - clang-tidy Documentation: https://clang.llvm.org/extra/clang-tidy/
#   - Project Makefile: make lint
#   - Project Standards: docs/MAKEFILE_DESIGN.md
#
# ==============================================================================

# ==============================================================================
# Check Selection Strategy
# ==============================================================================
#
# Philosophy:
#   1. Start with all checks disabled (-*)
#   2. Enable entire categories of useful checks
#   3. Selectively disable problematic or overly strict checks
#   4. Document all disabled checks with reasoning
#
# Categories:
#   - bugprone-*          : Detect potential bugs and logic errors
#   - cert-*              : CERT C++ Secure Coding Standard compliance
#   - clang-analyzer-*    : Static analysis from Clang Static Analyzer
#   - cppcoreguidelines-* : C++ Core Guidelines enforcement
#   - modernize-*         : C++11/14/17/20 modernization suggestions
#   - performance-*       : Performance optimization opportunities
#   - readability-*       : Code readability and maintainability
#   - misc-*              : Miscellaneous useful checks
#
# ==============================================================================

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  misc-*,
  -misc-non-private-member-variables-in-classes

# ==============================================================================
# Disabled Checks - Rationale
# ==============================================================================
#
# bugprone-easily-swappable-parameters:
#   Reason: Too many false positives in mathematical code (e.g., x, y coordinates)
#   Impact: Would require extensive refactoring of core algorithms
#   Alternative: Code review and unit tests
#
# cppcoreguidelines-avoid-magic-numbers:
#   Reason: Duplicates readability-magic-numbers (disabled below)
#   Impact: Overly strict for scientific/engineering constants
#   Alternative: Named constants where semantically meaningful
#
# cppcoreguidelines-pro-bounds-array-to-pointer-decay:
#   Reason: Eigen library extensively uses array-to-pointer decay
#   Impact: Conflicts with idiomatic Eigen usage
#   Alternative: Trust Eigen's battle-tested implementations
#
# cppcoreguidelines-pro-bounds-pointer-arithmetic:
#   Reason: Necessary for interop with Qt and Eigen APIs
#   Impact: Would prevent usage of standard library algorithms
#   Alternative: Careful code review in pointer-heavy sections
#
# cppcoreguidelines-pro-type-reinterpret-cast:
#   Reason: Required for low-level serialization and Qt type conversions
#   Impact: Would break binary I/O and Qt meta-object system
#   Alternative: Encapsulate reinterpret_casts in well-tested utilities
#
# modernize-use-trailing-return-type:
#   Reason: Not universally beneficial; reduces readability for simple functions
#   Impact: Would require massive codebase changes for minimal benefit
#   Alternative: Use trailing return types only where type deduction is complex
#
# readability-magic-numbers:
#   Reason: Too strict for engineering calculations (e.g., 2D = 2 dimensions)
#   Impact: Would create excessive named constants for obvious values
#   Alternative: Document magic numbers in context, extract when semantic
#
# readability-identifier-length:
#   Reason: Short names acceptable in limited scopes (e.g., 'i' for loop index)
#   Impact: Would prohibit idiomatic iterator and index variable names
#   Alternative: Enforce meaningful names in code review
#
# readability-function-cognitive-complexity:
#   Reason: Threshold too low for complex algorithms (matrix operations, parsing)
#   Impact: Would require artificial function splitting
#   Alternative: Use cyclomatic complexity metrics (covered by other checks)
#
# misc-non-private-member-variables-in-classes:
#   Reason: Conflicts with data-oriented design and Qt property system
#   Impact: Would prevent usage of Qt's Q_PROPERTY and public data members
#   Alternative: Use private members with getters/setters where encapsulation needed
#
# ==============================================================================

# ==============================================================================
# Warning Severity
# ==============================================================================
#
# WarningsAsErrors: ""
#   - Warnings are informational, not build-breaking
#   - Allows gradual improvement without blocking development
#   - CI/CD can enforce zero warnings without breaking local builds
#
# To enable warnings-as-errors in CI:
#   clang-tidy -warnings-as-errors='*' ...
#
# ==============================================================================

WarningsAsErrors: ""

# ==============================================================================
# Header Filter
# ==============================================================================
#
# HeaderFilterRegex: 'src/.*\.(h|hpp)$'
#   - Analyze only project headers (src/)
#   - Exclude third-party headers (Qt, Eigen, system headers)
#   - Prevents noise from external dependencies
#
# Pattern Breakdown:
#   src/       : Match headers in src/ directory
#   .*         : Any subdirectory depth
#   \.(h|hpp)$ : .h or .hpp file extension
#
# ==============================================================================

HeaderFilterRegex: 'src/.*\.(h|hpp)$'

# ==============================================================================
# Check Options - Naming Conventions
# ==============================================================================
#
# Naming Philosophy:
#   - Classes/Structs/Enums: CamelCase (UpperCamelCase)
#   - Functions/Variables: camelBack (lowerCamelCase)
#   - Private Members: m_ prefix (distinguishes from local variables)
#   - Constants: UPPER_CASE (distinguishes compile-time constants)
#   - Namespaces: lower_case (follows standard library convention)
#
# Examples:
#   class TrussElement { ... };               // CamelCase
#   void calculateForces() { ... }            // camelBack
#   double m_elasticModulus;                  // m_ prefix for members
#   const int MAX_NODES = 1000;               // UPPER_CASE constant
#   namespace truss_analysis { ... }          // lower_case namespace
#
# ==============================================================================

CheckOptions:
  # Namespace Naming
  # ----------------
  # Convention: lower_case (e.g., truss_analysis, file_io)
  # Rationale: Follows C++ standard library and Boost conventions
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  # Class and Type Naming
  # ---------------------
  # Convention: CamelCase (UpperCamelCase)
  # Rationale: Distinguishes types from variables, matches Qt/STL conventions
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase

  # Function and Variable Naming
  # -----------------------------
  # Convention: camelBack (lowerCamelCase)
  # Rationale: Distinguishes from types, common in modern C++
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack

  # Member Variable Naming
  # ----------------------
  # Convention: m_ prefix (e.g., m_nodeName, m_stiffnessMatrix)
  # Rationale: Clearly distinguishes member variables from local variables/parameters
  #            Prevents naming conflicts in constructors and setters
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: "m_"
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: "m_"

  # Constant Naming
  # ---------------
  # Convention: UPPER_CASE (e.g., MAX_NODES, DEFAULT_TOLERANCE)
  # Rationale: Visually distinguishes compile-time constants from variables
  - key: readability-identifier-naming.ConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE

  # ==============================================================================
  # Check Options - Code Metrics
  # ==============================================================================
  #
  # Function Size Limits:
  #   - Balance between readability and practicality
  #   - Allow complex algorithms without artificial splitting
  #   - Encourage decomposition of truly large functions
  #
  # Thresholds:
  #   - LineThreshold: 150 lines (generous for complex algorithms)
  #   - StatementThreshold: 100 statements (allows matrix operations)
  #
  # Rationale:
  #   - Engineering calculations can be legitimately complex
  #   - Matrix assembly algorithms need context preservation
  #   - Artificial splits can reduce readability
  #
  # ==============================================================================

  # Function Size - Line Count
  # --------------------------
  # Threshold: 150 lines
  # Rationale: Allows complex matrix operations and parsing logic
  #            Triggers warning for truly excessive functions
  - key: readability-function-size.LineThreshold
    value: 150

  # Function Size - Statement Count
  # --------------------------------
  # Threshold: 100 statements
  # Rationale: Permits comprehensive error checking and validation
  #            Encourages decomposition of mega-functions
  - key: readability-function-size.StatementThreshold
    value: 100

  # ==============================================================================
  # Check Options - Modernization
  # ==============================================================================
  #
  # C++ Modernization Strategy:
  #   - Prefer modern C++ features (auto, range-for, nullptr)
  #   - Respect Qt framework conventions (virtual destructors, signals/slots)
  #   - Balance between modern idioms and framework requirements
  #
  # ==============================================================================

  # Override Keyword - Destructor Handling
  # ---------------------------------------
  # Option: Ignore destructors (true)
  # Rationale: Qt virtual destructors don't need 'override' keyword
  #            Reduces noise in Qt-derived classes
  - key: modernize-use-override.IgnoreDestructors
    value: true

  # ==============================================================================
  # Check Options - Special Member Functions
  # ==============================================================================
  #
  # Rule of Five / Rule of Zero:
  #   - Prefer Rule of Zero (let compiler generate special members)
  #   - Allow default destructor only (common pattern)
  #   - Enforce full Rule of Five when any special member is user-defined
  #
  # ==============================================================================

  # Special Member Functions - Default Destructor
  # ----------------------------------------------
  # Option: Allow sole default destructor (true)
  # Rationale: Common pattern for RAII classes with compiler-generated members
  #            Permits explicit virtual destructor without other special members
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true

  # ==============================================================================
  # Check Options - Performance
  # ==============================================================================
  #
  # Move Semantics:
  #   - Encourage move semantics for expensive-to-copy types
  #   - Avoid unnecessary std::move on trivially copyable types
  #   - Optimize for Eigen matrix operations
  #
  # ==============================================================================

  # Move Semantics - Trivially Copyable Types
  # ------------------------------------------
  # Option: Don't check trivially copyable move (false)
  # Rationale: Moving int, double, etc. is not beneficial
  #            Reduces false positives for POD types
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: false

# ==============================================================================
# End of Configuration
# ==============================================================================
#
# Maintenance Notes:
#   - Review disabled checks periodically as clang-tidy evolves
#   - Add new C++23/26 checks as they become available
#   - Adjust thresholds based on codebase metrics and team feedback
#
# CI/CD Integration:
#   - Run via 'make lint' in continuous integration
#   - Consider enabling warnings-as-errors in CI only
#   - Generate reports for trend analysis
#
# Version History:
#   - v3.0.0 (2026-02-21): Comprehensive refactoring with enhanced documentation
#   - v2.x: Basic configuration with C++20 support
#
# ==============================================================================
