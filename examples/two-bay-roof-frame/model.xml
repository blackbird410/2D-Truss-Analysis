<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two-Bay Industrial Roof Frame - XML Format
  24 m total width, two symmetric 12 m Fink-style bays
  meeting at a shared central column.

  Supports: pinned at node 1, roller-y at nodes 4 and 7 (3 column supports).
  Static determinacy: m=22, r=4, j=13 → m+r=26=2j ✓
-->
<truss>
  <metadata name="Two-Bay Industrial Roof Frame"
            description="Two-bay 24 m wide industrial roof — two 12 m bays on three column supports"/>

  <materials>
    <material id="steel"
              youngModulus="2.0e11"
              poissonRatio="0.3"
              density="7850"
              yieldStrength="3.55e8"/>
  </materials>

  <sections>
    <section id="rhs_140"
             name="RHS 140x80x5 rafter"
             crossSectionalArea="0.002106"/>
    <section id="rhs_100"
             name="RHS 100x60x4 bottom chord"
             crossSectionalArea="0.001184"/>
    <section id="tube_80"
             name="SHS 80x80x4 web"
             crossSectionalArea="0.001184"/>
  </sections>

  <nodes>
    <!-- Bottom chord / column bases -->
    <node id="1"  x="0.0"  y="0.0" label="Left Column"/>
    <node id="2"  x="4.0"  y="0.0" label="Bottom L1"/>
    <node id="3"  x="8.0"  y="0.0" label="Bottom L2"/>
    <node id="4"  x="12.0" y="0.0" label="Centre Column"/>
    <node id="5"  x="16.0" y="0.0" label="Bottom R1"/>
    <node id="6"  x="20.0" y="0.0" label="Bottom R2"/>
    <node id="7"  x="24.0" y="0.0" label="Right Column"/>
    <!-- Top chord — two independent pitched bays -->
    <node id="8"  x="4.0"  y="2.0" label="Left Bay Rafter L Interior"/>
    <node id="9"  x="6.0"  y="3.0" label="Left Ridge"/>
    <node id="10" x="8.0"  y="2.0" label="Left Bay Rafter R Interior"/>
    <node id="11" x="16.0" y="2.0" label="Right Bay Rafter L Interior"/>
    <node id="12" x="18.0" y="3.0" label="Right Ridge"/>
    <node id="13" x="20.0" y="2.0" label="Right Bay Rafter R Interior"/>
  </nodes>

  <members>
    <!-- Left bay top chord (rafters) -->
    <member id="1"  startNode="1"  endNode="8"  material="steel" section="rhs_140" label="Left Bay TC L1"/>
    <member id="2"  startNode="8"  endNode="9"  material="steel" section="rhs_140" label="Left Bay TC L2"/>
    <member id="3"  startNode="9"  endNode="10" material="steel" section="rhs_140" label="Left Bay TC R1"/>
    <member id="4"  startNode="10" endNode="4"  material="steel" section="rhs_140" label="Left Bay TC R2"/>
    <!-- Right bay top chord (rafters) -->
    <member id="5"  startNode="4"  endNode="11" material="steel" section="rhs_140" label="Right Bay TC L1"/>
    <member id="6"  startNode="11" endNode="12" material="steel" section="rhs_140" label="Right Bay TC L2"/>
    <member id="7"  startNode="12" endNode="13" material="steel" section="rhs_140" label="Right Bay TC R1"/>
    <member id="8"  startNode="13" endNode="7"  material="steel" section="rhs_140" label="Right Bay TC R2"/>
    <!-- Bottom chord -->
    <member id="9"  startNode="1"  endNode="2"  material="steel" section="rhs_100" label="Bottom Chord 1"/>
    <member id="10" startNode="2"  endNode="3"  material="steel" section="rhs_100" label="Bottom Chord 2"/>
    <member id="11" startNode="3"  endNode="4"  material="steel" section="rhs_100" label="Bottom Chord 3"/>
    <member id="12" startNode="4"  endNode="5"  material="steel" section="rhs_100" label="Bottom Chord 4"/>
    <member id="13" startNode="5"  endNode="6"  material="steel" section="rhs_100" label="Bottom Chord 5"/>
    <member id="14" startNode="6"  endNode="7"  material="steel" section="rhs_100" label="Bottom Chord 6"/>
    <!-- Verticals -->
    <member id="15" startNode="2"  endNode="8"  material="steel" section="tube_80" label="Vertical L1"/>
    <member id="16" startNode="3"  endNode="10" material="steel" section="tube_80" label="Vertical L2"/>
    <member id="17" startNode="5"  endNode="11" material="steel" section="tube_80" label="Vertical R1"/>
    <member id="18" startNode="6"  endNode="13" material="steel" section="tube_80" label="Vertical R2"/>
    <!-- Fink diagonals (converge on ridge of each bay) -->
    <member id="19" startNode="2"  endNode="9"  material="steel" section="tube_80" label="Fink Diag L-Left"/>
    <member id="20" startNode="3"  endNode="9"  material="steel" section="tube_80" label="Fink Diag L-Right"/>
    <member id="21" startNode="5"  endNode="12" material="steel" section="tube_80" label="Fink Diag R-Left"/>
    <member id="22" startNode="6"  endNode="12" material="steel" section="tube_80" label="Fink Diag R-Right"/>
  </members>

  <supports>
    <support nodeId="1" type="pinned" restrained="x y"/>
    <support nodeId="4" type="roller" restrained="y"/>
    <support nodeId="7" type="roller" restrained="y"/>
  </supports>

  <loads>
    <load nodeId="8"  fx="0.0" fy="-30000.0"/>
    <load nodeId="9"  fx="0.0" fy="-30000.0"/>
    <load nodeId="10" fx="0.0" fy="-30000.0"/>
    <load nodeId="11" fx="0.0" fy="-30000.0"/>
    <load nodeId="12" fx="0.0" fy="-30000.0"/>
    <load nodeId="13" fx="0.0" fy="-30000.0"/>
  </loads>
</truss>
