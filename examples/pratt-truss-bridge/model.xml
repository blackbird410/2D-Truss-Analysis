    <member id="24" startNode="6"  endNode="12" material="steel" section="angle_150" label="Diag R2"/>
    <member id="25" startNode="5"  endNode="11" material="steel" section="angle_150" label="Diag R3"/>
  </members>

  <supports>
    <support nodeId="1" type="pinned" restrained="x y"/>
    <support nodeId="7" type="roller" restrained="y"/>
  </supports>

  <loads>
    <load nodeId="2" fx="0.0" fy="-40000.0"/>
    <load nodeId="3" fx="0.0" fy="-40000.0"/>
    <load nodeId="4" fx="0.0" fy="-40000.0"/>
    <load nodeId="5" fx="0.0" fy="-40000.0"/>
    <load nodeId="6" fx="0.0" fy="-40000.0"/>
  </loads>
</truss>
