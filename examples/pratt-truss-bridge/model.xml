<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pratt Truss Bridge - XML Format
  Single-span 6-panel Pratt truss — 24 m span, 4 m height.
  Vertical members in compression; diagonal members in tension.

  Static determinacy: m=25, r=3, j=14 → m+r=28=2j ✓
-->
<truss>
  <metadata name="Pratt Truss Bridge"
            description="Single-span 6-panel Pratt truss bridge — 24 m span, 4 m height"/>

  <materials>
    <material id="steel"
              youngModulus="2.0e11"
              poissonRatio="0.3"
              density="7850"
              yieldStrength="3.55e8"/>
  </materials>

  <sections>
    <section id="wide_flange_200"
             name="HEB 200 Wide Flange (chord)"
             crossSectionalArea="0.00781"/>
    <section id="angle_150"
             name="L150x150x12 Equal Angle (web)"
             crossSectionalArea="0.00347"/>
  </sections>

  <nodes>
    <!-- Bottom chord -->
    <node id="1"  x="0.0"  y="0.0" label="Left Support"/>
    <node id="2"  x="4.0"  y="0.0" label="Bottom 1"/>
    <node id="3"  x="8.0"  y="0.0" label="Bottom 2"/>
    <node id="4"  x="12.0" y="0.0" label="Bottom Centre"/>
    <node id="5"  x="16.0" y="0.0" label="Bottom 4"/>
    <node id="6"  x="20.0" y="0.0" label="Bottom 5"/>
    <node id="7"  x="24.0" y="0.0" label="Right Support"/>
    <!-- Top chord -->
    <node id="8"  x="0.0"  y="4.0" label="Top Left"/>
    <node id="9"  x="4.0"  y="4.0" label="Top 1"/>
    <node id="10" x="8.0"  y="4.0" label="Top 2"/>
    <node id="11" x="12.0" y="4.0" label="Top Centre"/>
    <node id="12" x="16.0" y="4.0" label="Top 4"/>
    <node id="13" x="20.0" y="4.0" label="Top 5"/>
    <node id="14" x="24.0" y="4.0" label="Top Right"/>
  </nodes>

  <members>
    <!-- Bottom chord -->
    <member id="1"  startNode="1"  endNode="2"  material="steel" section="wide_flange_200" label="BC 1-2"/>
    <member id="2"  startNode="2"  endNode="3"  material="steel" section="wide_flange_200" label="BC 2-3"/>
    <member id="3"  startNode="3"  endNode="4"  material="steel" section="wide_flange_200" label="BC 3-4"/>
    <member id="4"  startNode="4"  endNode="5"  material="steel" section="wide_flange_200" label="BC 4-5"/>
