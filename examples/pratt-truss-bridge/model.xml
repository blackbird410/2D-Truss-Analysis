    <member id="6"  startNode="6"  endNode="7"  material="steel" section="wide_flange_200" label="BC 6-7"/>
    <!-- Top chord -->
    <member id="7"  startNode="8"  endNode="9"  material="steel" section="wide_flange_200" label="TC 8-9"/>
    <member id="8"  startNode="9"  endNode="10" material="steel" section="wide_flange_200" label="TC 9-10"/>
    <member id="9"  startNode="10" endNode="11" material="steel" section="wide_flange_200" label="TC 10-11"/>
    <member id="10" startNode="11" endNode="12" material="steel" section="wide_flange_200" label="TC 11-12"/>
    <member id="11" startNode="12" endNode="13" material="steel" section="wide_flange_200" label="TC 12-13"/>
    <member id="12" startNode="13" endNode="14" material="steel" section="wide_flange_200" label="TC 13-14"/>
    <!-- Verticals (compression) -->
    <member id="13" startNode="1"  endNode="8"  material="steel" section="angle_150" label="End Post L"/>
    <member id="14" startNode="2"  endNode="9"  material="steel" section="angle_150" label="Vertical 2"/>
    <member id="15" startNode="3"  endNode="10" material="steel" section="angle_150" label="Vertical 3"/>
    <member id="16" startNode="4"  endNode="11" material="steel" section="angle_150" label="Vertical Centre"/>
    <member id="17" startNode="5"  endNode="12" material="steel" section="angle_150" label="Vertical 5"/>
    <member id="18" startNode="6"  endNode="13" material="steel" section="angle_150" label="Vertical 6"/>
    <member id="19" startNode="7"  endNode="14" material="steel" section="angle_150" label="End Post R"/>
    <!-- Diagonals (tension under gravity — Pratt characteristic) -->
    <member id="20" startNode="1"  endNode="9"  material="steel" section="angle_150" label="Diag L1"/>
    <member id="21" startNode="2"  endNode="10" material="steel" section="angle_150" label="Diag L2"/>
    <member id="22" startNode="3"  endNode="11" material="steel" section="angle_150" label="Diag L3"/>
