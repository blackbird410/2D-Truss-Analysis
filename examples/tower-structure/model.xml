<?xml version="1.0" encoding="UTF-8"?>
<!-- Tower Structure Example -->
<truss>
  <metadata name="Tower Structure" description="Multi-level tower with diagonal bracing"/>
  
  <!-- Material Library -->
  <materials>
    <material id="steel" 
              youngModulus="2.0e11" 
              poissonRatio="0.3"
              density="7850"
              yieldStrength="2.5e8"/>
  </materials>
  
  <!-- Section Library -->
  <sections>
    <section id="tube_100" 
             name="100x100mm Tube"
             crossSectionalArea="0.0038"/>
    <section id="tube_75" 
             name="75x75mm Tube"
             crossSectionalArea="0.00218"/>
    <section id="tube_50" 
             name="50x50mm Tube"
             crossSectionalArea="0.00145"/>
  </sections>
  
  <!-- Node Definitions -->
  <nodes>
    <node id="1" x="0.0" y="0.0" label="Base Left"/>
    <node id="2" x="4.0" y="0.0" label="Base Right"/>
    <node id="3" x="0.5" y="5.0" label="Level 1 Left"/>
    <node id="4" x="3.5" y="5.0" label="Level 1 Right"/>
    <node id="5" x="1.0" y="10.0" label="Level 2 Left"/>
    <node id="6" x="3.0" y="10.0" label="Level 2 Right"/>
    <node id="7" x="1.5" y="15.0" label="Level 3 Left"/>
    <node id="8" x="2.5" y="15.0" label="Level 3 Right"/>
    <node id="9" x="2.0" y="20.0" label="Top"/>
  </nodes>
  
  <!-- Member Definitions with Material/Section References -->
  <members>
    <member id="1" startNode="1" endNode="3" material="steel" section="tube_100"/>
    <member id="2" startNode="2" endNode="4" material="steel" section="tube_100"/>
    <member id="3" startNode="1" endNode="4" material="steel" section="tube_75"/>
    <member id="4" startNode="2" endNode="3" material="steel" section="tube_75"/>
    <member id="5" startNode="3" endNode="4" material="steel" section="tube_75"/>
    <member id="6" startNode="3" endNode="5" material="steel" section="tube_100"/>
    <member id="7" startNode="4" endNode="6" material="steel" section="tube_100"/>
    <member id="8" startNode="3" endNode="6" material="steel" section="tube_75"/>
    <member id="9" startNode="4" endNode="5" material="steel" section="tube_75"/>
    <member id="10" startNode="5" endNode="6" material="steel" section="tube_75"/>
    <member id="11" startNode="5" endNode="7" material="steel" section="tube_75"/>
    <member id="12" startNode="6" endNode="8" material="steel" section="tube_75"/>
    <member id="13" startNode="5" endNode="8" material="steel" section="tube_50"/>
    <member id="14" startNode="6" endNode="7" material="steel" section="tube_50"/>
    <member id="15" startNode="7" endNode="8" material="steel" section="tube_50"/>
    <member id="16" startNode="7" endNode="9" material="steel" section="tube_50"/>
    <member id="17" startNode="8" endNode="9" material="steel" section="tube_50"/>
  </members>
  
  <!-- Support Definitions -->
  <supports>
    <support nodeId="1" type="fixed" restrained="x y"/>
    <support nodeId="2" type="fixed" restrained="x y"/>
  </supports>
  
  <!-- Load Definitions -->
  <loads>
    <load nodeId="9" fx="0.0" fy="-10000.0" label="Top Vertical Load"/>
    <load nodeId="7" fx="20000.0" fy="0.0" label="Wind Load Level 3"/>
    <load nodeId="8" fx="20000.0" fy="0.0" label="Wind Load Level 3"/>
    <load nodeId="5" fx="30000.0" fy="0.0" label="Wind Load Level 2"/>
    <load nodeId="6" fx="30000.0" fy="0.0" label="Wind Load Level 2"/>
  </loads>
</truss>
