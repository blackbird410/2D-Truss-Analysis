#!/bin/sh
# packaging/debian/postinst
#
# Debian post-installation maintainer script for 2d-truss-analysis (GUI).
# Runs after the package files are unpacked.
#
# Responsibilities:
#   - Rebuild the XDG desktop database so the app appears in launchers
#   - Rebuild the hicolor icon cache so the application icon is visible

set -e

case "$1" in
    configure)
        # Update the desktop file database (GNOME, KDE, XFCE launchers)
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi

        # Update the icon theme cache
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
